{
    "elements": [
        {
            "type": "List",
            "name": "Accounts",
            "caption": "iCloud accounts",
            "rowCount": 4,
            "add": true,
            "delete": true,
            "columns": [
                {
                    "caption": "iCloud account",
                    "name": "AccountID",
                    "width": "auto",
                    "add": 0,
                    "edit": {
                        "type": "SelectInstance",
                        "validModules": [
                            "{10BF9A03-98A3-495A-B0FA-A4FA0B1002D5}"
                        ]
                    }
                }
            ]
        },
        {
            "type": "ExpansionPanel",
            "name": "DeviceSelectionPanel",
            "caption": "iCloud device selection",
            "items": [
                {
                    "type": "CheckBox",
                    "name": "ShowAllDevices",
                    "caption": "Show all devices"
                },
                {
                    "type": "Label",
                    "caption": "Clear Show all devices to use this list. Apply new account assignments and reopen the form to see their devices."
                },
                {
                    "type": "List",
                    "name": "SelectedDevices",
                    "caption": "Selected devices",
                    "rowCount": 5,
                    "add": true,
                    "delete": true,
                    "columns": [
                        {
                            "name": "DeviceKey",
                            "caption": "Device and account",
                            "width": "auto",
                            "add": "",
                            "edit": {
                                "type": "Select",
                                "options": [
                                    {
                                        "caption": "Select a cached device",
                                        "value": ""
                                    }
                                ]
                            }
                        }
                    ]
                }
            ]
        },
        {
            "type": "List",
            "name": "Vehicles",
            "caption": "Additional vehicles",
            "rowCount": 4,
            "add": true,
            "delete": true
        },
        {
            "type": "Select",
            "name": "VehicleMode",
            "caption": "Vehicle source",
            "onChange": "IPS_RequestAction($id, 'UpdateVehicleForm', json_encode([$VehicleMode, $VehicleJSONFormat ?? '']));",
            "options": [
                {
                    "caption": "Disabled",
                    "value": "off"
                },
                {
                    "caption": "Test vehicle",
                    "value": "demo"
                },
                {
                    "caption": "JSON variable",
                    "value": "json"
                },
                {
                    "caption": "Separate position variables",
                    "value": "fields"
                }
            ]
        },
        {
            "type": "Select",
            "name": "VehicleJSONFormat",
            "caption": "JSON format",
            "visible": false,
            "onChange": "IPS_RequestAction($id, 'UpdateVehicleForm', json_encode([$VehicleMode, $VehicleJSONFormat]));",
            "options": [
                {
                    "caption": "OpenWoIst",
                    "value": "json"
                },
                {
                    "caption": "BMW CarData",
                    "value": "bmw-cardata"
                },
                {
                    "caption": "OwnTracks",
                    "value": "owntracks"
                },
                {
                    "caption": "Traccar",
                    "value": "traccar"
                }
            ]
        },
        {
            "type": "ExpansionPanel",
            "name": "VehicleAssignments",
            "caption": "Vehicle variable assignments",
            "visible": false,
            "items": [
                {
                    "type": "ValidationTextBox",
                    "name": "VehicleName",
                    "caption": "Vehicle name"
                },
                {
                    "type": "SelectVariable",
                    "name": "VehiclePosition",
                    "caption": "JSON position variable",
                    "visible": false,
                    "validVariableTypes": [
                        3
                    ]
                },
                {
                    "type": "SelectVariable",
                    "name": "VehicleLatitude",
                    "caption": "Latitude",
                    "visible": false,
                    "validVariableTypes": [
                        1,
                        2
                    ]
                },
                {
                    "type": "SelectVariable",
                    "name": "VehicleLongitude",
                    "caption": "Longitude",
                    "visible": false,
                    "validVariableTypes": [
                        1,
                        2
                    ]
                },
                {
                    "type": "SelectVariable",
                    "name": "VehicleTimestamp",
                    "caption": "Position time (Unix seconds)",
                    "visible": false,
                    "validVariableTypes": [
                        1
                    ]
                }
            ]
        },
        {
            "type": "ExpansionPanel",
            "name": "VehicleAdvanced",
            "caption": "Advanced vehicle settings",
            "visible": false,
            "items": [
                {
                    "type": "Select",
                    "name": "VehicleTimeFormat",
                    "caption": "Measurement time format",
                    "options": [
                        {
                            "caption": "Source default",
                            "value": "default"
                        },
                        {
                            "caption": "ISO 8601 with time zone",
                            "value": "iso8601"
                        },
                        {
                            "caption": "Unix seconds",
                            "value": "unix-seconds"
                        },
                        {
                            "caption": "Unix milliseconds",
                            "value": "unix-milliseconds"
                        }
                    ]
                },
                {
                    "type": "Select",
                    "name": "VehicleDecimalSeparator",
                    "caption": "Coordinate decimal separator",
                    "options": [
                        {
                            "caption": "Decimal point",
                            "value": "."
                        },
                        {
                            "caption": "Decimal comma",
                            "value": ","
                        }
                    ]
                }
            ]
        },
        {
            "type": "NumberSpinner",
            "name": "StaleAfter",
            "caption": "Mark position as old after",
            "suffix": "s",
            "minimum": 60,
            "maximum": 86400
        }
    ],
    "actions": [
        {
            "type": "Button",
            "name": "MoveTestVehicle",
            "caption": "Move test vehicle",
            "visible": false,
            "onClick": "OWIS_NextDemoPosition($id);"
        },
        {
            "type": "Button",
            "name": "CheckVehicleSource",
            "caption": "Check saved vehicle source",
            "visible": false,
            "onClick": "IPS_RequestAction($id, 'CheckVehicleSource', '');"
        }
    ],
    "status": [
        {
            "code": 201,
            "icon": "error",
            "caption": "Location sources unavailable"
        }
    ]
}
