{
    "elements": [
        {
            "type": "ExpansionPanel",
            "name": "VehicleSources",
            "caption": "Vehicles",
            "expanded": true,
            "items": [
                {
                    "type": "List",
                    "name": "Vehicles",
                    "caption": "Additional vehicles",
                    "rowCount": 4,
                    "add": true,
                    "delete": true,
                    "columns": []
                },
                {
                    "type": "ExpansionPanel",
                    "name": "ExistingVehicleSettings",
                    "caption": "Existing vehicle source and test vehicle",
                    "items": [
                        {
                            "type": "Select",
                            "name": "VehicleMode",
                            "caption": "Vehicle source",
                            "onChange": "IPS_RequestAction($id, 'UpdateVehicleForm', json_encode([$VehicleMode, $VehicleJSONFormat ?? '']));",
                            "options": [
                                {
                                    "caption": "Disabled",
                                    "value": "off"
                                },
                                {
                                    "caption": "Test vehicle",
                                    "value": "demo"
                                },
                                {
                                    "caption": "One JSON variable",
                                    "value": "json"
                                },
                                {
                                    "caption": "Three position variables",
                                    "value": "fields"
                                }
                            ]
                        },
                        {
                            "type": "Select",
                            "name": "VehicleJSONFormat",
                            "caption": "JSON format",
                            "visible": false,
                            "onChange": "IPS_RequestAction($id, 'UpdateVehicleForm', json_encode([$VehicleMode, $VehicleJSONFormat]));",
                            "options": [
                                {
                                    "caption": "OpenWoIst JSON",
                                    "value": "json"
                                },
                                {
                                    "caption": "BMW CarData",
                                    "value": "bmw-cardata"
                                },
                                {
                                    "caption": "OwnTracks",
                                    "value": "owntracks"
                                },
                                {
                                    "caption": "Traccar",
                                    "value": "traccar"
                                }
                            ]
                        },
                        {
                            "type": "ExpansionPanel",
                            "name": "VehicleAssignments",
                            "caption": "Vehicle variable assignments",
                            "visible": false,
                            "items": [
                                {
                                    "type": "ValidationTextBox",
                                    "name": "VehicleName",
                                    "caption": "Vehicle name"
                                },
                                {
                                    "type": "SelectVariable",
                                    "name": "VehiclePosition",
                                    "caption": "JSON position variable",
                                    "visible": false,
                                    "validVariableTypes": [
                                        3
                                    ]
                                },
                                {
                                    "type": "SelectVariable",
                                    "name": "VehicleLatitude",
                                    "caption": "Latitude",
                                    "visible": false,
                                    "validVariableTypes": [
                                        1,
                                        2
                                    ]
                                },
                                {
                                    "type": "SelectVariable",
                                    "name": "VehicleLongitude",
                                    "caption": "Longitude",
                                    "visible": false,
                                    "validVariableTypes": [
                                        1,
                                        2
                                    ]
                                },
                                {
                                    "type": "SelectVariable",
                                    "name": "VehicleTimestamp",
                                    "caption": "Position time (Unix seconds)",
                                    "visible": false,
                                    "validVariableTypes": [
                                        1
                                    ]
                                }
                            ]
                        },
                        {
                            "type": "ExpansionPanel",
                            "name": "VehicleAdvanced",
                            "caption": "Advanced vehicle settings",
                            "visible": false,
                            "items": [
                                {
                                    "type": "Select",
                                    "name": "VehicleTimeFormat",
                                    "caption": "Measurement time format",
                                    "options": [
                                        {
                                            "caption": "Source default",
                                            "value": "default"
                                        },
                                        {
                                            "caption": "ISO 8601 with time zone",
                                            "value": "iso8601"
                                        },
                                        {
                                            "caption": "Unix seconds",
                                            "value": "unix-seconds"
                                        },
                                        {
                                            "caption": "Unix milliseconds",
                                            "value": "unix-milliseconds"
                                        }
                                    ]
                                },
                                {
                                    "type": "Select",
                                    "name": "VehicleDecimalSeparator",
                                    "caption": "Coordinate decimal separator",
                                    "options": [
                                        {
                                            "caption": "Decimal point",
                                            "value": "."
                                        },
                                        {
                                            "caption": "Decimal comma",
                                            "value": ","
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "type": "SelectColor",
                            "allowTransparent": true,
                            "transparentCaption": "Designer default",
                            "name": "VehicleMarkerColor",
                            "caption": "Marker color",
                            "visible": false
                        }
                    ]
                }
            ]
        },
        {
            "type": "ExpansionPanel",
            "name": "ICloudSources",
            "caption": "iCloud",
            "expanded": true,
            "items": [
                {
                    "type": "List",
                    "name": "Accounts",
                    "caption": "iCloud accounts",
                    "rowCount": 4,
                    "add": true,
                    "delete": true,
                    "columns": [
                        {
                            "caption": "iCloud account",
                            "name": "AccountID",
                            "width": "auto",
                            "add": 0,
                            "edit": {
                                "type": "SelectInstance",
                                "validModules": [
                                    "{10BF9A03-98A3-495A-B0FA-A4FA0B1002D5}"
                                ]
                            }
                        }
                    ]
                },
                {
                    "type": "CheckBox",
                    "name": "ShowAllDevices",
                    "caption": "Show all devices"
                },
                {
                    "type": "Label",
                    "caption": "The Selected column controls which devices are shown when Show all devices is off. Apply new account assignments and reopen the form to load their devices."
                },
                {
                    "type": "List",
                    "name": "SelectedDevices",
                    "caption": "Cached iCloud devices",
                    "rowCount": 6,
                    "loadValuesFromConfiguration": false,
                    "columns": [
                        {
                            "name": "DeviceKey",
                            "visible": false,
                            "save": true
                        },
                        {
                            "name": "DeviceLabel",
                            "caption": "Device and account",
                            "width": "auto",
                            "quickFilter": true,
                            "save": false
                        },
                        {
                            "name": "Included",
                            "caption": "Selected",
                            "width": "110px",
                            "edit": {
                                "type": "CheckBox"
                            }
                        },
                        {
                            "name": "MarkerColor",
                            "caption": "Marker color",
                            "width": "140px",
                            "edit": {
                                "type": "SelectColor",
                                "allowTransparent": true,
                                "transparentCaption": "Designer default"
                            }
                        }
                    ]
                }
            ]
        },
        {
            "type": "ExpansionPanel",
            "name": "GoogleCloudSources",
            "caption": "GoogleCloud",
            "items": [
                {
                    "type": "Label",
                    "caption": "A GoogleCloud location source has yet to be connected."
                }
            ]
        },
        {
            "type": "ExpansionPanel",
            "name": "TractiveSources",
            "caption": "Tractive GPS",
            "expanded": true,
            "items": [
                {
                    "type": "List",
                    "name": "TractiveTrackers",
                    "caption": "Tractive devices",
                    "rowCount": 3,
                    "add": true,
                    "delete": true,
                    "loadValuesFromConfiguration": false,
                    "columns": [
                        {
                            "name": "TractiveInstance",
                            "caption": "Tractive GPS device",
                            "width": "auto",
                            "add": 0,
                            "edit": {
                                "type": "SelectInstance",
                                "validModules": [
                                    "{A259E80D-C7B4-F5A9-F82B-B9B05F71B4F3}"
                                ]
                            }
                        },
                        {
                            "name": "TractivePetName",
                            "caption": "Pet name",
                            "width": "220px",
                            "add": "",
                            "edit": {
                                "type": "ValidationTextBox"
                            }
                        },
                        {
                            "name": "TractiveMarkerColor",
                            "caption": "Marker color",
                            "width": "140px",
                            "add": -1,
                            "edit": {
                                "type": "SelectColor",
                                "allowTransparent": true,
                                "transparentCaption": "Designer default"
                            }
                        }
                    ]
                },
                {
                    "type": "Label",
                    "name": "TractiveSetupRequired",
                    "caption": "No Tractive GPS device found. Install Tractive GPS from the Module Store and set up a device there."
                }
            ]
        },
        {
            "type": "ExpansionPanel",
            "name": "TrackerSources",
            "caption": "Additional location devices",
            "items": [
                {
                    "type": "List",
                    "name": "Trackers",
                    "caption": "Location devices",
                    "rowCount": 4,
                    "add": true,
                    "delete": true,
                    "columns": [
                        {
                            "name": "TrackerName",
                            "caption": "Device name",
                            "width": "auto",
                            "add": "",
                            "edit": {
                                "type": "ValidationTextBox"
                            }
                        },
                        {
                            "name": "TrackerFormat",
                            "caption": "JSON format",
                            "width": "170px",
                            "add": "owntracks",
                            "edit": {
                                "type": "Select",
                                "options": [
                                    {
                                        "caption": "OwnTracks",
                                        "value": "owntracks"
                                    },
                                    {
                                        "caption": "OpenWoIst JSON",
                                        "value": "json"
                                    }
                                ]
                            }
                        },
                        {
                            "name": "TrackerPosition",
                            "caption": "JSON position variable",
                            "width": "260px",
                            "add": 0,
                            "edit": {
                                "type": "SelectVariable",
                                "validVariableTypes": [
                                    3
                                ]
                            }
                        },
                        {
                            "name": "TrackerMarkerColor",
                            "caption": "Marker color",
                            "width": "140px",
                            "add": -1,
                            "edit": {
                                "type": "SelectColor",
                                "allowTransparent": true,
                                "transparentCaption": "Designer default"
                            }
                        }
                    ]
                },
                {
                    "type": "Label",
                    "caption": "Use OpenWoIst JSON for a complete position from sources such as Home Assistant or MQTT GPS."
                }
            ]
        },
        {
            "type": "ExpansionPanel",
            "name": "AddressResolution",
            "caption": "Address resolution",
            "items": [
                {
                    "type": "CheckBox",
                    "name": "EnableAddressResolution",
                    "caption": "Resolve positions to addresses"
                },
                {
                    "type": "Select",
                    "name": "AddressProvider",
                    "caption": "Address provider",
                    "options": [
                        {
                            "caption": "Private Nominatim server",
                            "value": "nominatim"
                        },
                        {
                            "caption": "Geoapify (external service)",
                            "value": "geoapify"
                        }
                    ]
                },
                {
                    "type": "ValidationTextBox",
                    "name": "NominatimServer",
                    "caption": "Private Nominatim server base URL"
                },
                {
                    "type": "PasswordTextBox",
                    "name": "GeoapifyAPIKey",
                    "caption": "Geoapify API key"
                },
                {
                    "type": "NumberSpinner",
                    "name": "GeoapifyDailyLimit",
                    "caption": "Geoapify requests per day (UTC, 0 disables requests)",
                    "minimum": 0,
                    "maximum": 1000000
                },
                {
                    "type": "ValidationTextBox",
                    "name": "AddressLanguage",
                    "caption": "Address language (e.g. de or en)"
                },
                {
                    "type": "Label",
                    "caption": "The selected address provider receives the coordinates. Geoapify requires your own API key."
                },
                {
                    "type": "Label",
                    "name": "AddressConfigurationError",
                    "visible": false,
                    "caption": "Check the address provider settings."
                }
            ]
        },
        {
            "type": "ExpansionPanel",
            "name": "ZoneSettings",
            "caption": "Zones",
            "items": [
                {
                    "type": "List",
                    "name": "Zones",
                    "caption": "Circular zones",
                    "rowCount": 4,
                    "add": true,
                    "delete": true,
                    "changeOrder": true,
                    "columns": [
                        {
                            "name": "name",
                            "caption": "Zone name",
                            "width": "auto",
                            "add": "",
                            "edit": {
                                "type": "ValidationTextBox",
                                "validate": "^.*\\S.*$"
                            }
                        },
                        {
                            "name": "latitude",
                            "caption": "Latitude",
                            "width": "130px",
                            "add": 0,
                            "edit": {
                                "type": "NumberSpinner",
                                "digits": 6,
                                "minimum": -90,
                                "maximum": 90
                            }
                        },
                        {
                            "name": "longitude",
                            "caption": "Longitude",
                            "width": "130px",
                            "add": 0,
                            "edit": {
                                "type": "NumberSpinner",
                                "digits": 6,
                                "minimum": -180,
                                "maximum": 180
                            }
                        },
                        {
                            "name": "radius",
                            "caption": "Radius (m)",
                            "width": "120px",
                            "add": 100,
                            "edit": {
                                "type": "NumberSpinner",
                                "minimum": 1,
                                "maximum": 1000000
                            }
                        }
                    ]
                },
                {
                    "type": "Label",
                    "caption": "When zones overlap, the first matching zone takes priority."
                },
                {
                    "type": "ExpansionPanel",
                    "caption": "Position quality",
                    "items": [
                        {
                            "type": "NumberSpinner",
                            "name": "ZoneBoundaryBuffer",
                            "caption": "Zone boundary buffer",
                            "suffix": "m",
                            "minimum": 0,
                            "maximum": 10000
                        },
                        {
                            "type": "NumberSpinner",
                            "name": "ZoneMaxAccuracy",
                            "caption": "Maximum location uncertainty",
                            "suffix": "m",
                            "minimum": 1,
                            "maximum": 10000
                        },
                        {
                            "type": "NumberSpinner",
                            "name": "ZoneConfirmationTime",
                            "caption": "Confirm zone changes after",
                            "suffix": "s",
                            "minimum": 0,
                            "maximum": 3600
                        }
                    ]
                },
                {
                    "type": "Label",
                    "name": "ZoneConfigurationError",
                    "visible": false,
                    "caption": "Check the zone names, coordinates and GPS settings. Each radius must exceed the boundary buffer."
                }
            ]
        },
        {
            "type": "NumberSpinner",
            "name": "StaleAfter",
            "caption": "Mark position as old after",
            "suffix": "s",
            "minimum": 60,
            "maximum": 86400
        }
    ],
    "actions": [
        {
            "type": "Button",
            "name": "MoveTestVehicle",
            "caption": "Move test vehicle",
            "visible": false,
            "onClick": "OWIS_NextDemoPosition($id);"
        },
        {
            "type": "Button",
            "name": "CheckVehicleSource",
            "caption": "Check saved vehicle source",
            "visible": false,
            "onClick": "IPS_RequestAction($id, 'CheckVehicleSource', '');"
        }
    ],
    "status": [
        {
            "code": 201,
            "icon": "error",
            "caption": "Location sources unavailable"
        }
    ]
}
