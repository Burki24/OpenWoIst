{
    "elements": [
        {
            "type": "List",
            "name": "Accounts",
            "caption": "iCloud accounts",
            "rowCount": 4,
            "add": true,
            "delete": true,
            "columns": [
                {
                    "caption": "iCloud account",
                    "name": "AccountID",
                    "width": "auto",
                    "add": 0,
                    "edit": {
                        "type": "SelectInstance",
                        "validModules": [
                            "{10BF9A03-98A3-495A-B0FA-A4FA0B1002D5}"
                        ]
                    }
                }
            ]
        },
        {
            "type": "Select",
            "name": "VehicleMode",
            "caption": "Vehicle source",
            "onChange": "$convertOptions = in_array($VehicleMode, ['bmw-cardata', 'owntracks'], true); IPS_UpdateFormField($id, 'VehicleTimeFormat', 'visible', $convertOptions); IPS_UpdateFormField($id, 'VehicleDecimalSeparator', 'visible', $convertOptions);",
            "options": [
                {
                    "caption": "Disabled",
                    "value": "off"
                },
                {
                    "caption": "Test vehicle",
                    "value": "demo"
                },
                {
                    "caption": "JSON position variable",
                    "value": "json"
                },
                {
                    "caption": "Separate position variables",
                    "value": "fields"
                },
                {
                    "caption": "BMW CarData (JSON)",
                    "value": "bmw-cardata"
                },
                {
                    "caption": "OwnTracks (JSON)",
                    "value": "owntracks"
                }
            ]
        },
        {
            "type": "ExpansionPanel",
            "caption": "Vehicle variable assignments",
            "items": [
                {
                    "type": "ValidationTextBox",
                    "name": "VehicleName",
                    "caption": "Vehicle name"
                },
                {
                    "type": "SelectVariable",
                    "name": "VehiclePosition",
                    "caption": "JSON position variable",
                    "validVariableTypes": [
                        3
                    ]
                },
                {
                    "type": "Select",
                    "name": "VehicleTimeFormat",
                    "caption": "Measurement time format",
                    "visible": false,
                    "options": [
                        {
                            "caption": "Source default",
                            "value": "default"
                        },
                        {
                            "caption": "ISO 8601 with time zone",
                            "value": "iso8601"
                        },
                        {
                            "caption": "Unix seconds",
                            "value": "unix-seconds"
                        },
                        {
                            "caption": "Unix milliseconds",
                            "value": "unix-milliseconds"
                        }
                    ]
                },
                {
                    "type": "Select",
                    "name": "VehicleDecimalSeparator",
                    "caption": "Coordinate decimal separator",
                    "visible": false,
                    "options": [
                        {
                            "caption": "Decimal point",
                            "value": "."
                        },
                        {
                            "caption": "Decimal comma",
                            "value": ","
                        }
                    ]
                },
                {
                    "type": "SelectVariable",
                    "name": "VehicleLatitude",
                    "caption": "Latitude",
                    "validVariableTypes": [
                        1,
                        2
                    ]
                },
                {
                    "type": "SelectVariable",
                    "name": "VehicleLongitude",
                    "caption": "Longitude",
                    "validVariableTypes": [
                        1,
                        2
                    ]
                },
                {
                    "type": "SelectVariable",
                    "name": "VehicleTimestamp",
                    "caption": "Position time (Unix seconds)",
                    "validVariableTypes": [
                        1
                    ]
                }
            ]
        },
        {
            "type": "NumberSpinner",
            "name": "StaleAfter",
            "caption": "Mark position as old after",
            "suffix": "s",
            "minimum": 60,
            "maximum": 86400
        }
    ],
    "actions": [
        {
            "type": "Button",
            "caption": "Move test vehicle",
            "onClick": "OWIS_NextDemoPosition($id);"
        }
    ],
    "status": [
        {
            "code": 201,
            "icon": "error",
            "caption": "Location sources unavailable"
        }
    ]
}
